{
  "apiVersion": "demo.ssli.io/v1alpha1",
  "kind": "Pipeline",
  "metadata": {"name": "model-comparison-demo"},
  "spec": {
    "nodes": [
      {"id": "generate", "type": "data-generator", "version": "1.0.0", "name": "生成数据", "parameters": {"sampleCount": 1000, "featureCount": 10, "durationSeconds": 2}},
      {"id": "preprocess", "type": "preprocess", "version": "1.0.0", "name": "数据预处理", "parameters": {"cleanRatio": 0.95, "durationSeconds": 2}},
      {"id": "train-a", "type": "mock-training", "version": "1.0.0", "name": "模拟训练A", "parameters": {"algorithm": "qwen-demo-a", "durationSeconds": 8, "accuracy": 0.86, "retryLimit": 2, "failMode": "never"}},
      {"id": "train-b", "type": "mock-training", "version": "1.0.0", "name": "模拟训练B", "parameters": {"algorithm": "qwen-demo-b", "durationSeconds": 8, "accuracy": 0.89, "retryLimit": 2, "failMode": "never"}},
      {"id": "compare", "type": "compare-models", "version": "1.0.0", "name": "模型对比", "parameters": {}},
      {"id": "report", "type": "generate-report", "version": "1.0.0", "name": "生成报告", "parameters": {}}
    ],
    "edges": [
      {"source": "generate", "sourcePort": "dataset", "target": "preprocess", "targetPort": "dataset"},
      {"source": "preprocess", "sourcePort": "processedDataset", "target": "train-a", "targetPort": "dataset"},
      {"source": "preprocess", "sourcePort": "processedDataset", "target": "train-b", "targetPort": "dataset"},
      {"source": "train-a", "sourcePort": "model", "target": "compare", "targetPort": "modelA"},
      {"source": "train-b", "sourcePort": "model", "target": "compare", "targetPort": "modelB"},
      {"source": "compare", "sourcePort": "bestModel", "target": "report", "targetPort": "model"}
    ],
    "runPolicy": {"timeoutSeconds": 300}
  },
  "uiLayout": {
    "nodes": {
      "generate": {"x": 40, "y": 220}, "preprocess": {"x": 280, "y": 220},
      "train-a": {"x": 540, "y": 100}, "train-b": {"x": 540, "y": 340},
      "compare": {"x": 800, "y": 220}, "report": {"x": 1040, "y": 220}
    }
  }
}
